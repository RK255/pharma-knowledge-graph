#!/usr/bin/env python3
"""
Extract Full Connectivity for All CID-Matched Ingredients
==========================================================

This script processes all ~2,900 ingredients that have CID mappings and extracts
their full connectivity paths (PINs, MINs, BNs, SCDGs, SCDs, SBDs, NDCs, Set IDs)
enriched with PubChem properties.

Based on extract_for_geo_import.py logic but scaled to all CID-matched ingredients.
"""

import json
from pathlib import Path
from datetime import datetime

# Define file paths
DATA_DIR = Path(__file__).parent.parent.parent.parent.parent / "data" / "grc20_v2"
RAW_DATA_DIR = Path(__file__).parent.parent.parent.parent.parent / "data" / "raw_data"

RXNORM_ENTITIES_FILE = DATA_DIR / "rxnorm_entities.jsonl"
CID_MAPPING_FILE = DATA_DIR / "pubchem_cid_mapping.json"
ENRICHED_ENTITIES_FILE = DATA_DIR / "rxnorm_entities_enriched.jsonl"
NDC_TO_SETID_FILE = RAW_DATA_DIR / "ndc_to_setid.json"
NDC_TO_RXCUI_FILE = RAW_DATA_DIR / "ndc_to_rxcui.json"
RELATION_FILE = DATA_DIR / "rxnorm_relations.jsonl"
SETID_TO_DAILYMED_FILE = RAW_DATA_DIR / "setid_to_dailymed.json"
OUTPUT_FILE = DATA_DIR / "all_cid_ingredients_connectivity.json"

# BLOCKED_TTYS: Secondary codes to BLOCK (never capture)
BLOCKED_TTYS = {"TMSY", "PSN", "SY"}

# UNDOCUMENTED RELATION TYPES discovered through investigation
UNDOCUMENTED_TYPES = {
    "dd9264e954d650f98f97cc5d471e5a51",  # SCDF/SCDG -> SCD
    "cbf90e604bf458719df7ad10fd90c07f",  # DF -> SCD
    "f44019f93b2258119d1022c4f39b9da5",  # MIN -> SCD
    "1df119c2ba785c688aafd35556e3fab6",  # IN -> MIN
    "94272e15b3535feab43867d3b374f608",  # MIN -> IN/PIN
    "12a84f5c305857b782821609c5e2b59b",  # SCD -> SCDG/TMSY
    "b74d6b2005505263a22c10fe0ed1f591",  # DFG -> SCDG
}


def load_data():
    """Load all required data files"""
    print("Loading data...")
    
    # Load NDC to Set ID mappings
    with open(NDC_TO_SETID_FILE, 'r') as f:
        ndc_to_setid = json.load(f)
    print(f"  Loaded {len(ndc_to_setid):,} NDC -> Set ID mappings")
    
    # Load NDC to RxCUI mappings
    with open(NDC_TO_RXCUI_FILE, 'r') as f:
        ndc_to_rxcui = json.load(f)
    print(f"  Loaded {len(ndc_to_rxcui):,} NDC -> RxCUI mappings")
    
    # Build RxCUI -> NDCs mapping
    rxcui_to_ndcs = {}
    for ndc, rxcui in ndc_to_rxcui.items():
        if rxcui not in rxcui_to_ndcs:
            rxcui_to_ndcs[rxcui] = []
        rxcui_to_ndcs[rxcui].append(ndc)
    print(f"  Built RxCUI -> NDCs mapping: {len(rxcui_to_ndcs):,} RxCUIs")
    
    # Load RxNorm entities
    rxcui_to_entity_id = {}
    rxcui_to_name = {}
    rxcui_to_tty = {}
    
    with open(RXNORM_ENTITIES_FILE, 'r') as f:
        for line in f:
            entity = json.loads(line)
            entity_id = entity['id']
            
            for value in entity.get('values', []):
                prop = value.get('property')
                val = value.get('value')
                
                if prop == 'c6f36f8a8e22546ea7618ac008d2f91e':  # rxcui
                    rxcui_to_entity_id[val] = entity_id
                elif prop == 'a126ca530c8e48d5b88882c734c38935':  # name
                    rxcui_to_name[entity_id] = val
                elif prop == 'fd0c76eae47c55bbac4cca96203752c1':  # tty
                    rxcui_to_tty[entity_id] = val
    
    print(f"  Loaded {len(rxcui_to_entity_id):,} RxNorm entities")
    
    # Build relationship graph (forward)
    rel_graph = {}
    with open(RELATION_FILE, 'r') as f:
        for line in f:
            rel = json.loads(line)
            from_id = rel['from']
            to_id = rel['to']
            
            if from_id not in rel_graph:
                rel_graph[from_id] = []
            rel_graph[from_id].append({
                'to': to_id,
                'type': rel['type']
            })
    
    print(f"  Built relationship graph (FORWARD): {len(rel_graph):,} source RxCUIs")
    
    # Load Set ID -> DailyMed mappings
    with open(SETID_TO_DAILYMED_FILE, 'r') as f:
        setid_to_dailymed = json.load(f)
    print(f"  Loaded {len(setid_to_dailymed):,} Set ID -> DailyMed mappings")
    
    # Load enriched RxNorm entities
    enriched_entities = {}
    with open(ENRICHED_ENTITIES_FILE, 'r') as f:
        for line in f:
            entity = json.loads(line)
            enriched_entities[entity['id']] = entity
    print(f"  Loaded {len(enriched_entities):,} enriched RxNorm entities")
    
    # Load CID mapping file
    with open(CID_MAPPING_FILE, 'r') as f:
        cid_mapping_data = json.load(f)
    
    cid_mapping = cid_mapping_data.get('cid_mapping', {})
    print(f"  Loaded {len(cid_mapping):,} CID mappings")
    
    return {
        'ndc_to_setid': ndc_to_setid,
        'ndc_to_rxcui': ndc_to_rxcui,
        'rxcui_to_ndcs': rxcui_to_ndcs,
        'rxcui_to_entity_id': rxcui_to_entity_id,
        'rxcui_to_name': rxcui_to_name,
        'rxcui_to_tty': rxcui_to_tty,
        'rel_graph': rel_graph,
        'setid_to_dailymed': setid_to_dailymed,
        'enriched_entities': enriched_entities,
        'cid_mapping': cid_mapping
    }


def fetch_pubchem_properties(cid, enriched_entities):
    """Fetch PubChem properties using CID
    
    This function checks if an entity with the given CID exists in the enriched entities,
    and if found, extracts the PubChem properties.
    
    Args:
        cid: PubChem Compound ID as string
        enriched_entities: Dictionary of enriched RxNorm entities
    
    Returns:
        Dictionary of PubChem properties or None if not found
    """
    # Search for entity with the given CID in enriched entities
    for entity_id, entity in enriched_entities.items():
        for prop in entity.get('values', []):
            if prop.get('property') == 'bdd863e095365bbea65deae8ebf1e81b' and prop.get('value') == cid:
                # Found entity with this CID, extract properties
                properties = {}
                
                # Property IDs for PubChem data (from pharma_schema.py)
                PROP_CID = "bdd863e095365bbea65deae8ebf1e81b"      # pubchem_cid
                PROP_SMILES = "56e99a1b93b2573689e2f6a6c662df10"   # smiles
                PROP_INCHI = "6b432fc791ad5358b1f17fdc6abcfacc"     # inchikey (actually contains InChI string)
                PROP_PMID = "c2842d1831e35b2f82fb74b532f4508b"      # pmid (PubMed ID)
                PROP_IUPAC = "5fbf742a110d508abc9af6a1cd1e49e7"     # iupac_name
                PROP_FORMULA = "20aba01a611d57e1bb02ca665dd61acd"   # molecular_formula (with MW)
                
                for prop in entity.get('values', []):
                    prop_id = prop.get('property')
                    value = prop.get('value')
                    
                    if prop_id == PROP_CID:
                        properties['pubchem_cid'] = value
                    elif prop_id == PROP_SMILES:
                        properties['smiles'] = value
                    elif prop_id == PROP_INCHI:
                        # Note: This property ID maps to "inchikey" in schema but contains InChI string
                        properties['inchi'] = value
                    elif prop_id == PROP_PMID:
                        properties['pmid'] = value
                    elif prop_id == PROP_IUPAC:
                        properties['iupac_name'] = value
                    elif prop_id == PROP_FORMULA:
                        # Clean up molecular formula (remove molecular weight)
                        if '\t' in value:
                            value = value.split('\t')[0]
                        properties['molecular_formula'] = value
                
                return properties if properties else None
    
    return None


def extract_ingredient_data(ingredient_name, in_rxcui, data):
    """Extract full connectivity data for an ingredient
    
    This function extracts all connected entities (PINs, MINs, BNs, SCDGs, SCDs, SBDs, NDCs, Set IDs)
    for an ingredient starting from its RxCUI.
    
    Args:
        ingredient_name: Name of the ingredient
        in_rxcui: RxCUI of the ingredient (IN code)
        data: Dictionary containing all loaded data
    
    Returns:
        Dictionary containing the ingredient's connectivity data
    """
    # Get entity ID for the IN code
    in_entity_id = data['rxcui_to_entity_id'].get(in_rxcui)
    if not in_entity_id:
        return None
    
    # Initialize the result structure
    result = {
        'ingredient': {
            'rxcui': in_rxcui,
            'name': ingredient_name,
            'entity_id': in_entity_id,
            'geo_type': 'Ingredient',
            'source_tty': 'IN'
        },
        'pins': {},
        'mins': {},
        'bns': {},
        'scdgs': {},
        'scds': {},
        'sbds': {},
        'ndcs': [],
        'set_ids': set()
    }
    
    # Get CID from mapping
    cid = data['cid_mapping'].get(in_rxcui, {}).get('cid')
    
    # Extract PubChem properties for the ingredient
    pubchem_props = None
    if cid:
        pubchem_props = fetch_pubchem_properties(cid, data['enriched_entities'])
    
    # Build the ingredient data with PubChem properties at the top level
    ingredient_data = {
        'ingredient': ingredient_name,
        'rxcui': in_rxcui,
        'entities': {
            'ingredient': result['ingredient']
        }
    }
    
    # Add PubChem properties at the top level if available
    if pubchem_props:
        ingredient_data['pubchem_properties'] = pubchem_props
    
    # Find related PINs and MINs from the IN code
    related_pins = []
    related_mins = []
    
    if in_entity_id in data['rel_graph']:
        for rel in data['rel_graph'][in_entity_id]:
            to_entity_id = rel['to']
            tty = data['rxcui_to_tty'].get(to_entity_id)
            name = data['rxcui_to_name'].get(to_entity_id, 'Unknown')
            
            if tty == 'PIN':
                related_pins.append({'rxcui': data['rxcui_to_entity_id'].get(to_entity_id), 'name': name})
            elif tty == 'MIN':
                related_mins.append({'rxcui': data['rxcui_to_entity_id'].get(to_entity_id), 'name': name})
    
    print(f"  Found {len(related_pins)} related PINs")
    print(f"  Found {len(related_mins)} related MINs")
    
    # Track all entities we've processed to avoid duplicates
    processed_entities = {in_entity_id}
    
    # Walk from IN
    print("  Walking from IN...")
    
    # Process related PINs
    for pin in related_pins:
        pin_entity_id = pin['rxcui']
        if pin_entity_id and pin_entity_id not in processed_entities:
            print(f"    Walking from PIN: {pin_entity_id} ({pin['name']})...")
            walk_starting_point(pin_entity_id, 'PIN', data, result, processed_entities)
    
    # Process related MINs
    for min_entry in related_mins:
        min_entity_id = min_entry['rxcui']
        if min_entity_id and min_entity_id not in processed_entities:
            print(f"    Walking from MIN: {min_entity_id} ({min_entry['name']})...")
            walk_starting_point(min_entity_id, 'MIN', data, result, processed_entities)
    
    # Add the ingredient entity to the entities dict
    ingredient_data['entities']['ingredient'] = result['ingredient']
    
    # Add all collected entities
    if result['pins']:
        ingredient_data['entities']['pins'] = result['pins']
    if result['mins']:
        ingredient_data['entities']['mins'] = result['mins']
    if result['bns']:
        ingredient_data['entities']['bns'] = result['bns']
    if result['scdgs']:
        ingredient_data['entities']['scdgs'] = result['scdgs']
    if result['scds']:
        ingredient_data['entities']['scds'] = result['scds']
    if result['sbds']:
        ingredient_data['entities']['sbds'] = result['sbds']
    if result['ndcs']:
        ingredient_data['entities']['ndcs'] = result['ndcs']
    if result['set_ids']:
        ingredient_data['entities']['set_ids'] = list(result['set_ids'])
    
    return ingredient_data


def walk_starting_point(starting_rxcui, source_type, data, result, processed_entities):
    """Walk from a starting point (PIN/IN/MIN) DOWN the hierarchy
    
    This function traverses the relationship graph starting from a given entity
    and collects all connected entities of specific types (BN, SCDG, SCD, SBD, NDC).
    
    Args:
        starting_rxcui: RxCUI to start from
        source_type: Type of starting point ('PIN', 'IN', 'MIN')
        data: Dictionary containing all loaded data
        result: Dictionary to store the collected entities
        processed_entities: Set of already processed entity IDs
    """
    if starting_rxcui in processed_entities:
        return
    
    processed_entities.add(starting_rxcui)
    
    # Get TTY for the starting point
    tty = data['rxcui_to_tty'].get(starting_rxcui)
    name = data['rxcui_to_name'].get(starting_rxcui, 'Unknown')
    
    # Early TTY blocking - check BEFORE any processing or categorization
    if tty in BLOCKED_TTYS:
        return
    
    # Categorize the entity
    entity_data = {
        'rxcui': data['rxcui_to_entity_id'].get(starting_rxcui),
        'name': name,
        'source_tty': tty,
        'geo_type': 'Unknown'
    }
    
    # Map TTY to geo_type
    tty_to_geo_type = {
        'IN': 'Ingredient',
        'PIN': 'PreciseIngredient',
        'MIN': 'MultipleIngredient',
        'BN': 'BrandName',
        'SCDG': 'ClinicalDrugGroup',
        'SCD': 'ClinicalDrug',
        'SBD': 'BrandedDrug',
        'SBDG': 'BrandedDrugGroup',
    }
    entity_data['geo_type'] = tty_to_geo_type.get(tty, 'Unknown')
    
    # Add to appropriate category
    if tty == 'BN':
        result['bns'][starting_rxcui] = entity_data
    elif tty == 'SCDG':
        result['scdgs'][starting_rxcui] = entity_data
    elif tty == 'SCD':
        result['scds'][starting_rxcui] = entity_data
    elif tty == 'SBD':
        result['sbds'][starting_rxcui] = entity_data
    
    # Collect NDCs for this RxCUI
    if starting_rxcui in data['rxcui_to_ndcs']:
        for ndc in data['rxcui_to_ndcs'][starting_rxcui]:
            result['ndcs'].append({
                'ndc': ndc,
                'rxcui': starting_rxcui
            })
            
            # Add Set ID
            if ndc in data['ndc_to_setid']:
                result['set_ids'].add(data['ndc_to_setid'][ndc])
    
    # Walk to connected entities
    if starting_rxcui in data['rel_graph']:
        for rel in data['rel_graph'][starting_rxcui]:
            to_entity_id = rel['to']
            
            # Check if this is a valid relationship type
            rel_type = rel['type']
            valid_type = (rel_type in UNDOCUMENTED_TYPES or
                         rel_type in ['has_ingredient', 'has_precise_ingredient', 'has_ingredients',
                                     'has_doseformgroup', 'has_dose_form', 'has_tradename',
                                     'has_boss', 'has_form', 'has_quantified_form',
                                     'has_clinical_drug', 'has_branded_drug',
                                     'has_component', 'has_group'])
            
            if valid_type:
                walk_starting_point(to_entity_id, tty, data, result, processed_entities)


def main():
    """Main function to process all CID-matched ingredients"""
    print("=" * 80)
    print("EXTRACT FULL CONNECTIVITY FOR ALL CID-MATCHED INGREDIENTS")
    print("=" * 80)
    
    # Load all required data
    data = load_data()
    
    # Get all CID-matched ingredients
    target_ingredients = []
    for rxcui, mapping in data['cid_mapping'].items():
        ingredient_name = mapping.get('name', 'Unknown')
        target_ingredients.append((ingredient_name, rxcui))
    
    print(f"\nProcessing {len(target_ingredients):,} CID-matched ingredients...")
    
    # Process all ingredients
    ingredients_data = []
    total_pins = 0
    total_mins = 0
    total_bns = 0
    total_scdgs = 0
    total_scds = 0
    total_sbds = 0
    total_ndcs = 0
    total_set_ids = 0
    
    for idx, (ingredient_name, in_rxcui) in enumerate(target_ingredients):
        print(f"\nProcessing: {ingredient_name} (RxCUI: {in_rxcui})")
        
        # Extract data for this ingredient
        ingredient_data = extract_ingredient_data(ingredient_name, in_rxcui, data)
        
        if ingredient_data:
            ingredients_data.append(ingredient_data)
            
            # Update statistics
            entities = ingredient_data.get('entities', {})
            total_pins += len(entities.get('pins', {}))
            total_mins += len(entities.get('mins', {}))
            total_bns += len(entities.get('bns', {}))
            total_scdgs += len(entities.get('scdgs', {}))
            total_scds += len(entities.get('scds', {}))
            total_sbds += len(entities.get('sbds', {}))
            total_ndcs += len(entities.get('ndcs', []))
            total_set_ids += len(entities.get('set_ids', []))
            
            print(f"  OK Ingredient: {ingredient_name}")
            if 'pins' in entities:
                print(f"     Related PINs: {len(entities['pins'])}")
            if 'mins' in entities:
                print(f"     Related MINs: {len(entities['mins'])}")
            if 'bns' in entities:
                print(f"     Brand Names (BN): {len(entities['bns'])}")
            if 'scdgs' in entities:
                print(f"     SCDGs: {len(entities['scdgs'])}")
            if 'scds' in entities:
                print(f"     SCDs: {len(entities['scds'])}")
            if 'sbds' in entities:
                print(f"     SBDs: {len(entities['sbds'])}")
            if 'ndcs' in entities:
                print(f"     NDCs: {len(entities['ndcs'])}")
            if 'set_ids' in entities:
                print(f"     Set IDs: {len(entities['set_ids'])}")
    
    # Save results to JSON file
    print(f"\nSaving results to: {OUTPUT_FILE}")
    output_data = {
        'metadata': {
            'generated_at': datetime.now().isoformat(),
            'total_ingredients': len(ingredients_data),
            'total_pins': total_pins,
            'total_mins': total_mins,
            'total_bns': total_bns,
            'total_scdgs': total_scdgs,
            'total_scds': total_scds,
            'total_sbds': total_sbds,
            'total_ndcs': total_ndcs,
            'total_set_ids': total_set_ids
        },
        'ingredients': ingredients_data
    }
    
    with open(OUTPUT_FILE, 'w') as f:
        json.dump(output_data, f, indent=2)
    
    # Print summary
    print("\n" + "=" * 80)
    print("EXTRACTION COMPLETE")
    print("=" * 80)
    print(f"  Ingredients: {len(ingredients_data):,}")
    print(f"  Total PINs: {total_pins:,}")
    print(f"  Total MINs: {total_mins:,}")
    print(f"  Brand Names: {total_bns:,}")
    print(f"  SCDGs: {total_scdgs:,}")
    print(f"  SCDs: {total_scds:,}")
    print(f"  SBDs: {total_sbds:,}")
    print(f"  NDCs: {total_ndcs:,}")
    print(f"  Set IDs: {total_set_ids:,}")
    print(f"  Output file: {OUTPUT_FILE}")
    print("=" * 80)


if __name__ == "__main__":
    main()

# Neo4j connection (optional - only needed for direct graph loading)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# Venice AI API (optional - only needed for description enrichment)
VENICE_API_KEY=your_venice_key_here

# Base data directory (defaults to parent of pipeline repo)
# GRC20_BASE_DIR=/path/to/your/data/root
